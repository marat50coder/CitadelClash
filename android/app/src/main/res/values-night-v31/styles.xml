<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch theme (dark mode). Same splash icon and background
         so it matches the launcher icon in either system theme. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowSplashScreenBackground">@color/launch_sky</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_sky</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_sky</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
