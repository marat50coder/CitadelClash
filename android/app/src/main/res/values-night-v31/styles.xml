<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch theme (dark). Same splash icon and background as
         the light variant so the splash matches the launcher icon in either
         system theme (the icon gradient is dark enough on its own; recolouring
         it would drift from the home-screen art). -->
    <!-- postSplashScreenTheme is intentionally omitted — see values-v31/styles.xml.
         The activity theme flips to NormalTheme via the manifest meta-data. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
