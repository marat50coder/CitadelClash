<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon. Byte-identical to mipmap-anydpi-v26/ic_launcher.xml
     so the launch screen shows the exact same adaptive icon as the home-screen
     ярлык.

     The SplashScreen API rejects anything that isn't an AdaptiveIconDrawable
     and silently falls back to the launcher icon — meaning a flat PNG here
     would show up clipped on Android 12+ devices. Keep this file an
     <adaptive-icon>. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
