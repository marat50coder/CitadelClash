<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon. Identical to the launcher adaptive icon so the
     splash matches the icon on the home screen. The Android 12 splash accepts
     only an AdaptiveIconDrawable. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_icon_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_icon_fg"
            android:inset="18%" />
    </foreground>
</adaptive-icon>
