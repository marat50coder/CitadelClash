<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch theme (light). AndroidManifest points the launcher
         activity at LaunchTheme, so this is the theme the SplashScreen API
         reads its windowSplashScreen* attributes from. Flutter's embedding
         swaps the activity theme to @style/NormalTheme after boot via the
         `io.flutter.embedding.android.NormalTheme` <meta-data> in the manifest
         — we deliberately do NOT set `android:postSplashScreenTheme` because
         that attribute lives in androidx.core:core-splashscreen, not the
         platform, so declaring it here would fail aapt2 linking. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
