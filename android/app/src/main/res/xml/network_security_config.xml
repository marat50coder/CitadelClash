<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Partners routinely deliver push/track URLs over plain HTTP; behave
         like Chrome and allow cleartext rather than maintaining a domain
         allow-list that silently breaks. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
