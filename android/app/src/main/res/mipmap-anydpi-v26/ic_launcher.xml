<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+), full-bleed art strategy.
     The background layer already carries a gradient + centred artwork (see
     drawable-nodpi/ic_launcher_art.png, generated by
     tool/make_launcher_icons.dart at ~16% padding), so the foreground is a
     transparent no-op. Whatever mask a launcher applies (Pixel circle,
     squircle, teardrop, rounded-square) only trims gradient pixels, never
     the composition. Kept byte-identical to ic_launcher_round.xml and
     drawable-anydpi-v26/ic_splash_logo.xml so the round icon and the Android
     12+ splash render exactly like the home-screen icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
