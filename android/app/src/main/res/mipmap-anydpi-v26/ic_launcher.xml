<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon. The full artwork is inset so the crane and tower fit inside
     the mask with room to spare, while the gradient background (ic_icon_bg)
     extends the sky/ground colours to cover the whole icon, leaving no empty
     border under any mask (circle, squircle, teardrop). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_icon_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_icon_fg"
            android:inset="18%" />
    </foreground>
</adaptive-icon>
