<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive round launcher icon. Byte-identical to ic_launcher.xml — the
     AdaptiveIconDrawable pipeline decides which mask to apply, so shipping
     both keeps launchers that hard-code round icons (some OEM skins) happy
     without diverging the source art. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
